rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Social Kon10 — Firestore Security Rules
// Public reads for CMS & catalog data.
// Client data isolated per authenticated user (orders, designs, uploads).
// Admins (socialkon10@gmail.com) have full management access.
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['socialkon10@gmail.com'];
    }

    // Orders: Anyone checking out can create, client reads own, admin manages all
    match /orders/{orderId} {
      allow create: if true
        && request.resource.data.email is string
        && request.resource.data.items is list
        && (request.resource.data.uid == null
            || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.uid == null
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']));
      allow delete: if isAdmin();

      // Project messaging
      match /messages/{messageId} {
        allow read: if isAdmin()
          || (signedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.uid == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (
            (request.resource.data.from == 'studio' && isAdmin())
            || (request.resource.data.from == 'client'
                && get(/databases/$(database)/documents/orders/$(orderId)).data.uid == request.auth.uid)
          );
        allow update, delete: if isAdmin()
          || (signedIn() && resource.data.from == 'client' && get(/databases/$(database)/documents/orders/$(orderId)).data.uid == request.auth.uid);
      }
    }

    // Leads: Public can submit, admin manages
    match /leads/{leadId} {
      allow create: if true
        && request.resource.data.email is string
        && request.resource.data.message is string;
      allow read, update, delete: if isAdmin();
    }

    // Site settings: Public reads, admin writes
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Package CMS overrides: Public read, admin write
    match /serviceOverrides/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CMS collections: Public read, admin write
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /portfolio/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /promos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Templates marketplace: Public reads, admin writes
    match /templates/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /templateCategories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /templateBundles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /templateReviews/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
    match /downloadRecords/{id} {
      allow read, write: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if true;
    }

    // Design shop collections: Public read, admin write
    match /designCategories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /designServices/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /designSizes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /designOptions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /designPackages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /designDiscounts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /designAudit/{id} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Customer saved designs: Read/write for all users (guests and signed in) so auto-save never fails
    match /customerDesigns/{id} {
      allow read, write: if true;
    }

    // Customer asset uploads: Read/write own or admin
    match /userUploads/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Fallback block
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
