rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Social Kon10 — Firestore Security Rules (2026 Hardened RLS)
// Public reads for CMS & catalog data.
// Client data isolated strictly per authenticated user (orders, designs, uploads).
// Admins (socialkon10@gmail.com) have full management access.
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['socialkon10@gmail.com', 'maddcre8tive@gmail.com'];
    }

    // Orders: Anyone checking out can create, client reads own, admin manages all
    match /orders/{orderId} {
      // Customers can open an order — but NEVER with money already marked paid.
      // Payment fields are admin/server-only; a client-created order must start
      // unpaid so a forged "paid" state can never be written from the browser.
      allow create: if true
        && request.resource.data.email is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.total is number
        && (isAdmin() || (
          request.resource.data.amountPaid == 0
          && (!request.resource.data.keys().hasAny(['paymentStatus'])
              || request.resource.data.paymentStatus in ['UNPAID', 'PENDING'])
        ))
        && (request.resource.data.uid == null
            || (signedIn() && request.resource.data.uid == request.auth.uid));

      allow read: if isAdmin()
        || (signedIn()
            && (resource.data.uid == request.auth.uid
                || (resource.data.email is string && request.auth.token.email != null && resource.data.email.lower() == request.auth.token.email.lower())));

      // Clients may only touch workflow fields on their own orders — never
      // prices, payment fields, checkout method, or references.
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'files', 'revisionFeedback', 'approvedAt', 'notes', 'lastClientMessageAt', 'lastClientMessageBy', 'clientReadAt', 'completedAt', 'statusHistory'])
            && (request.resource.data.status == resource.data.status
                || request.resource.data.status in ['REVISION', 'FINAL APPROVAL', 'CLIENT REVIEW', 'COMPLETED']))
        || (signedIn()
            && request.auth.token.email != null
            && resource.data.email.lower() == request.auth.token.email.lower()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']));

      allow delete: if isAdmin();

      // Communication activity (WhatsApp follow-up log) — studio-only.
      // Events are append-only: prepared/opened, never "delivered".
      match /events/{eventId} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }

      // Project messaging
      match /messages/{messageId} {
        allow read: if isAdmin()
          || (signedIn() && (get(/databases/$(database)/documents/orders/$(orderId)).data.uid == request.auth.uid || (get(/databases/$(database)/documents/orders/$(orderId)).data.email is string && request.auth.token.email != null && get(/databases/$(database)/documents/orders/$(orderId)).data.email.lower() == request.auth.token.email.lower())));
        allow create: if signedIn()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (
            (request.resource.data.from == 'studio' && isAdmin())
            || (request.resource.data.from == 'client'
                && (get(/databases/$(database)/documents/orders/$(orderId)).data.uid == request.auth.uid || (get(/databases/$(database)/documents/orders/$(orderId)).data.email is string && request.auth.token.email != null && get(/databases/$(database)/documents/orders/$(orderId)).data.email.lower() == request.auth.token.email.lower())))
          );
        allow update, delete: if isAdmin()
          || (signedIn() && resource.data.from == 'client' && (get(/databases/$(database)/documents/orders/$(orderId)).data.uid == request.auth.uid || (get(/databases/$(database)/documents/orders/$(orderId)).data.email is string && request.auth.token.email != null && get(/databases/$(database)/documents/orders/$(orderId)).data.email.lower() == request.auth.token.email.lower())));
      }
    }

    // Leads: Public can submit, admin manages
    match /leads/{leadId} {
      allow create: if true
        && request.resource.data.email is string
        && request.resource.data.message is string;
      allow read, update, delete: if isAdmin();
    }

    // Public order references (SK10-YYMMDD-XXXXX): reservation tokens.
    // Create-only so a reference can never be reassigned or deleted;
    // document ID must match the reference format; no public reads, so a
    // reference can never be used to look up customer information.
    match /orderRefs/{refId} {
      allow create: if true
        && refId.matches('SK10-[0-9]{6}-[A-Z0-9]{5}')
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt is string;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Website client intakes (project briefs + signed agreements)
    // Guests can start a brief right after checkout (uid null, id is unguessable);
    // once claimed by an account, only that client + admin can touch it.
    match /intakes/{intakeId} {
      allow create: if true
        && request.resource.data.email is string
        && (request.resource.data.uid == null
            || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow read: if isAdmin()
        || (signedIn()
            && (resource.data.uid == request.auth.uid
                || (resource.data.email is string && request.auth.token.email != null && resource.data.email.lower() == request.auth.token.email.lower())));
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || (signedIn() && resource.data.email.lower() == request.auth.token.email.lower())
        || resource.data.uid == null;
      allow delete: if isAdmin();
    }

    // Saved client profiles (account details → faster checkout prefill)
    match /profiles/{uid} {
      allow read, write: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Transactional email queue (Trigger Email extension) — write-only, never readable
    match /mail/{id} {
      allow create: if true
        && request.resource.data.to is string
        && request.resource.data.message.subject is string
        && request.resource.data.message.html is string
        && request.resource.data.message.subject.size() <= 200
        && request.resource.data.message.html.size() <= 100000;
      allow read, update, delete: if false;
    }

    // Site settings: Public reads, admin writes
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Package CMS overrides: Public read, admin write
    match /serviceOverrides/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CMS collections: Public read, admin write
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /portfolio/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /promos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Templates marketplace: Public reads, admin writes
    match /templates/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /templateCategories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /templateBundles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /templateReviews/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
    match /downloadRecords/{id} {
      allow read, write: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if true;
    }

    // Design shop collections: Public read, admin write
    match /designCategories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /designServices/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /designSizes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /designOptions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /designPackages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /designDiscounts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /designAudit/{id} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Website Power Up Add-Ons (PRD §32/§35) & Agency Services
    match /websiteAddons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /websiteAddonCategories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /agencyServices/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer saved designs: Isolated per user/guest, protected against unauthorized access
    match /customerDesigns/{id} {
      allow read: if isAdmin()
        || resource.data.uid == null
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if true
        && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow update: if isAdmin()
        || (resource.data.uid == null && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == request.auth.uid)))
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin()
        || resource.data.uid == null
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Customer asset uploads: Read/write own, guest, or admin
    match /userUploads/{id} {
      allow create: if true;
      allow read: if isAdmin()
        || resource.data.uid == null
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin()
        || resource.data.uid == null
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Studio Meetings & Live Video Communications
    match /meetings/{meetingId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();

      match /chat/{chatId} {
        allow read, create, update: if true;
        allow delete: if isAdmin();
      }

      match /signals/{signalId} {
        allow read, create, update, delete: if true;
      }

      match /{sub=**} {
        allow read, write: if true;
      }
    }

    // Live Calls & Consultation Records
    match /call_history/{callId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // First-Party Website Intelligence & Analytics Engine (PRD §1-5)
    // Public/anonymous creation for event streaming; admin-only reads & management
    match /analytics_sessions/{sessionId} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }
    match /analytics_events/{eventId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /analytics_page_views/{viewId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /analytics_service_interest/{interestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /analytics_conversions/{convId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Finance & Document Management (Finance PRD Phase 1) ──────────────────
    // Documents are viewable via direct client share links; writes are strictly admin-only.
    // Audit log is append-only (immutable).


    // Token-gated customer quote decisions. A quote may move sent →
    // accepted/declined by an anonymous client ONLY while carrying a valid,
    // unexpired docAccess token scoped to that document, touching nothing
    // but the decision evidence fields. Prices, items, and totals are
    // never writable here.
    function validQuoteDecision(docId) {
      let before = resource.data;
      let after = request.resource.data;
      return before.type == "quote"
        && before.status == "sent"
        && after.status in ["accepted", "declined"]
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["status", "decisionAt", "decisionBy", "decisionToken", "updatedAt"])
        && after.decisionToken is string
        && exists(/databases/$(database)/documents/docAccess/$(after.decisionToken))
        && get(/databases/$(database)/documents/docAccess/$(after.decisionToken)).data.docId == docId
        && get(/databases/$(database)/documents/docAccess/$(after.decisionToken)).data.kind == "quote_approval"
        && get(/databases/$(database)/documents/docAccess/$(after.decisionToken)).data.expiresAtMs > request.time.toMillis()
      ;
    }

    match /financeDocuments/{id} {
      // Single-doc GET stays open because the unguessable doc ID is the
      // share credential. LIST is admin-only — an enumerable document
      // number must never expose every customer's invoice.
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || validQuoteDecision(id);
    }

    // Scoped, expiring access grants for quote approval links. The token
    // (document ID) is the credential: anyone holding it may read the
    // grant; only admins can mint one.
    match /docAccess/{token} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    // Future-ready payment links. The link ID is the bearer credential for
    // the status page; all writes are admin-only (a future provider webhook
    // will arrive through a Cloud Function with admin credentials).
    match /paymentLinks/{id} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }
    match /financePayments/{id} {
      allow read, write: if isAdmin();
    }
    match /financeTaxRates/{id} {
      allow read, write: if isAdmin();
    }
    match /financeDocSequences/{id} {
      allow read, write: if isAdmin();
    }
    match /financeClients/{id} {
      allow read, write: if isAdmin();
    }
    match /financeAuditLog/{id} {
      // Immutable audit trail: admins can read and create, but never update or delete
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Fallback block
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
