# ─────────────────────────────────────────────────────────────
# Social Kon10 — Firebase configuration
# 1. Go to https://console.firebase.google.com → Add project
# 2. Enable: Authentication (Email/Password + Google), Firestore, Storage
# 3. Project settings → Your apps → Web app → copy the config values below
# 4. Copy this file to ".env.local" and fill in the real values
# 5. Redeploy rules: firebase deploy --only firestore:rules,storage
# Without these values the site runs in demo mode (no data persists).
# ─────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated emails that get the admin dashboard
VITE_ADMIN_EMAILS=socialkon10@gmail.com

# Analytics (PRD §60) — optional. Leave blank to load zero third-party scripts.
# GA4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA_ID=
# Meta Pixel ID
VITE_META_PIXEL_ID=
