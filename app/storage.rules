rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Social Kon10 — Storage Rules
// ─────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['socialkon10@gmail.com'];
    }

    // Orders attachments: upload during checkout / order details
    match /orders/{orderId}/{fileName} {
      allow write: if request.resource.size < 25 * 1024 * 1024;
      allow read: if isAdmin() || request.auth != null;
    }

    // Portfolio + CMS image uploads: admin writes, public reads
    match /portfolio/{fileName} {
      allow write: if isAdmin()
        && request.resource.size < 15 * 1024 * 1024;
      allow read: if true;
    }

    // Template files & design assets: admin writes, public / buyer reads
    match /template-files/{allPaths=**} {
      allow write: if isAdmin()
        && request.resource.size < 100 * 1024 * 1024;
      allow read: if true;
    }

    // Template preview images: admin writes, public reads
    match /template-previews/{allPaths=**} {
      allow write: if isAdmin()
        && request.resource.size < 25 * 1024 * 1024;
      allow read: if true;
    }

    // User uploads & customer assets
    match /userUploads/{allPaths=**} {
      allow write: if request.resource.size < 25 * 1024 * 1024;
      allow read: if true;
    }

    // Customer saved design files
    match /customerDesigns/{allPaths=**} {
      allow write: if request.resource.size < 25 * 1024 * 1024;
      allow read: if true;
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
